{
  "name": "xyron-center",
  "version": "1.1.0",
  "description": "XYRON CENTER - Standalone Full-Screen Sci-Fi HUD Workstation Telemetry & Terminal Utility",
  "main": "src/main/index.js",
  "author": "Xyron",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/run-all.js",
    "test:fast": "node tests/run-all.js --fast",
    "export-txt": "node export-to-txt.js",
    "build": "electron-builder --win --x64",
    "rebuild": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "node-pty": "^1.1.0",
    "systeminformation": "^5.33.19",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.xyron.center",
    "productName": "XyronCenter",
    "directories": {
      "output": "../3_Final_EXE_Uygulama",
      "buildResources": "assets"
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "assets/icon.ico"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!tests/**/*",
      "!export-to-txt.js",
      "!build-all.bat",
      "!**/_preview*",
      "!**/node_modules/node-pty/{deps,src,third_party,scripts}/**",
      "!**/node_modules/node-pty/prebuilds/{darwin-arm64,darwin-x64,win32-arm64}/**",
      "!**/node_modules/node-pty/lib/**/*.test.js",
      "!**/node_modules/node-pty/**/*.{pdb,map,ts}"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**/*",
      "assets/icon.ico",
      "assets/icon.png"
    ],
    "portable": {
      "artifactName": "XyronCenter-Portable.exe",
      "requestExecutionLevel": "admin"
    },
    "compression": "maximum"
  }
}
